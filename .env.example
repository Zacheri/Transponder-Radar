# Free key from https://aisstream.io/account (GitHub sign-in). Shown once.
AISSTREAM_API_KEY=
PORT=2001
# Full-globe poll = 4 credits. Standard tier (OAuth2) = 4,000 credits/day;
# 90 s default = 960 polls/day = 3,840 credits — stays within budget 24/7.
# Anonymous = 400 credits/day (~100 globe polls) and 429s under continuous polling.
OPENSKY_POLL_MS=90000
# OpenSky OAuth2 client (Account page -> API clients -> download credentials.json).
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
BATCH_MS=1000
STALE_MS=120000
REMOVE_MS=600000
# Free key from https://account.carto.com — Carto dark basemap. If unset or invalid, the map falls back to OpenFreeMap dark (no key).
VITE_CARTO_API_KEY=
# Timeline rewind: snapshot cadence (ms) and disk cap in bytes — oldest snapshots are
# evicted first once the cap is exceeded (data/history/).
HISTORY_SNAPSHOT_MS=60000
HISTORY_MAX_BYTES=10737418240
# Initial default (GB) for the decoded-snapshot RAM cache; 0 = off.
# Overridden at runtime by data/settings.json.
HISTORY_RAM_CACHE_GB=1
# FAA bulk registry refresh (ms). First run downloads a ~73 MB zip (~220 MB extracted) into data/faa/.
FAA_REFRESH_MS=86400000
