# Free key from https://aisstream.io/account (GitHub sign-in). Shown once.
AISSTREAM_API_KEY=
PORT=8787
# Anonymous OpenSky is limited to ~100 req/hour, so 36 s keeps the aircraft feed alive; lower values will 429.
OPENSKY_POLL_MS=36000
# Optional: free OpenSky credentials (https://opensky-network.org) raise the rate limit far above anonymous.
OPENSKY_USERNAME=
OPENSKY_PASSWORD=
BATCH_MS=1000
STALE_MS=120000
REMOVE_MS=600000
# Free key from https://account.carto.com — Carto dark basemap. If unset or invalid, the map falls back to OpenFreeMap dark (no key).
VITE_CARTO_API_KEY=
